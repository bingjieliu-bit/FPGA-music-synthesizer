module top(CLOCK_50, KEY, SW, PS2_CLK, PS2_DAT,
					LEDR, HEX0, HEX1, HEX2, freq_data, AUD_BCLK,
	AUD_ADCLRCK,
	AUD_DACLRCK, AUD_ADCDAT,AUD_XCK,
	AUD_DACDAT,

	FPGA_I2C_SCLK,);
   input CLOCK_50;
	input [0:0] KEY;
	input [3:0] SW;
	
	inout PS2_CLK;
	inout PS2_DAT;
	
	output [6:0] HEX0, HEX1, HEX2;
	output [9:0] LEDR;

	output [119:0] freq_data; // 12 note * 10 bit

keyboard_to_frequency K0(CLOCK_50, KEY, SW, PS2_CLK, PS2_DAT,
					LEDR, HEX0, HEX1, HEX2, freq_data);
audio A0(
	// Inputs
	CLOCK_50,
	KEY,

	AUD_ADCDAT,

	// Bidirectionals
	AUD_BCLK,
	AUD_ADCLRCK,
	AUD_DACLRCK,

	FPGA_I2C_SDAT,

	// Outputs
	AUD_XCK,
	AUD_DACDAT,

	FPGA_I2C_SCLK,
	SW,
	freq_data
);
endmodule
